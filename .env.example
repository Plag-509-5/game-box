# =====================================================================
# Box — configuration du serveur. Copie ce fichier en `.env` (jamais commité).
# Ne jamais exposer ces valeurs via une variable VITE_* (publique).
# =====================================================================

# --- Serveur ---
# Adresse d'écoute (0.0.0.0 = toutes les interfaces, requis sur Pterodactyl/Docker).
HOST=0.0.0.0
# Port d'écoute. Pterodactyl injecte SERVER_PORT (allocation) : il est utilisé
# automatiquement si PORT est absent.
PORT=8787
NODE_ENV=development

# URL publique du serveur (recommandé en production, requis pour Google OAuth
# si GOOGLE_REDIRECT_URI n'est pas défini). Ex. : https://box.ton-domaine.fr
APP_URL=http://localhost:8787
# Origine de l'interface si elle est hébergée séparément de l'API (sinon vide).
FRONTEND_URL=
# Origines autorisées (CORS + cookies), séparées par des virgules.
APP_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8787
# true UNIQUEMENT si l'interface et l'API sont sur deux domaines (cookies SameSite=None, HTTPS requis).
COOKIE_CROSS_SITE=false

# --- MongoDB ---
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@VOTRE_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=box

# --- Google OAuth (optionnel, voir README « Connexion Google ») ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI exacte déclarée dans Google Cloud (doit correspondre au caractère près).
# Si vide, dérivée de APP_URL : ${APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Dev uniquement ---
# Port de l'API ciblée par le proxy Vite (npm run dev). Défaut : PORT ou 8787.
API_PORT=8787
# Forcer un serveur PeerJS externe pour le multijoueur (défaut : /peerjs auto-hébergé).
# VITE_PEER_HOST=0.peerjs.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
